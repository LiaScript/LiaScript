{-| Quiz inputs `0 ..` in the given states, options for every input.
-}
withInput : Bool -> List State -> List Bool -> Config () -> Config ()
withInput active states partial c =
    { c
        | input =
            { state = Array.fromList states
            , options =
                Array.fromList
                    (List.map
                        (\_ -> [ [ Chars "opt0" [] ], [ Bold (Chars "opt1" []) [] ], [ Chars "opt2" [] ] ])
                        states
                    )
            , randomize = Nothing
            , on = \cmd id value -> "on(" ++ cmd ++ "," ++ String.fromInt id ++ "," ++ value ++ ")"
            , path = []
            , active = active
            , partiallyCorrect = Array.fromList partial
            }
    }


