{-| Quiz inputs, rendered with input 0 in the given state.
-}
quizzes : List ( String, Config (), Inline )
quizzes =
    let
        quiz =
            Quiz ( "5rem", 0 ) attr
    in
    [ ( "text active", withInput True [ Text "abc" ] [] config, quiz )
    , ( "text inactive", withInput False [ Text "abc" ] [] config, quiz )
    , ( "text correct", withInput True [ Text "abc" ] [ True ] config, quiz )
    , ( "text wrong", withInput True [ Text "abc" ] [ False ] config, quiz )
    , ( "text resolved hides highlight", withInput False [ Text "abc" ] [ False ] config, quiz )
    , ( "select closed", withInput True [ Select False [ 1 ] ] [] config, quiz )
    , ( "select open", withInput True [ Select True [ -1 ] ] [] config, quiz )
    , ( "select out of range", withInput True [ Select False [ 7 ] ] [ True ] config, quiz )
    , ( "select inactive", withInput False [ Select True [ 0 ] ] [] config, quiz )
    , ( "select randomized"
      , let
            c =
                withInput True [ Select True [ 0 ] ] [] config

            input =
                c.input
        in
        { c | input = { input | randomize = Just (Array.fromList [ [ 2, 0, 1 ] ]) } }
      , quiz
      )
    , ( "select multiple", withInput True [ Select False [ 0, 1 ] ] [] config, quiz )
    , ( "drop single", withInput True [ Drop False False [ 1 ] ] [] config, quiz )
    , ( "drop single empty", withInput True [ Drop False False [ 9 ] ] [ True ] config, quiz )
    , ( "drop single wrong", withInput True [ Drop False False [ 0 ] ] [ False ] config, quiz )
    , ( "drop empty", withInput True [ Drop False False [] ] [] config, quiz )
    , ( "drop pair", withInput True [ Drop True False [ 0, 2 ] ] [ True ] config, quiz )
    , ( "drop pair wrong", withInput True [ Drop False True [ 0, 1 ] ] [ False ] config, quiz )
    , ( "missing state", withInput True [] [] config, quiz )
    ]


expectSnapshot : String -> Html (Msg ()) -> Expect.Expectation
expectSnapshot name html =
    case Dict.get name snapshots of
        Just recorded ->
            HtmlSnapshot.expect recorded html

        Nothing ->
            Expect.fail ("RECORD:" ++ HtmlSnapshot.toString html)


snapshot : String -> Html (Msg ()) -> Test
snapshot name html =
    test name <| \_ -> expectSnapshot name html


wrap : List (Html (Msg ())) -> Html (Msg ())
wrap =
    Html.div []


drops : Config ()
drops =
    withInput True
        [ Drop False True [ 1 ]
        , Text "x"
        , Drop False False [ 0, 2 ]
        , Drop True False []
        ]
        []
        config


suite : Test
suite =
    describe "Lia.Markdown.Inline.View snapshots"
        [ inlines
            |> List.map (\( name, inline ) -> snapshot ("view " ++ name) (View.view config inline))
            |> describe "view"
        , inlines
            |> List.map (\( name, inline ) -> snapshot ("presentation " ++ name) (View.view presentation inline))
            |> describe "view in presentation"
        , quizzes
            |> List.map (\( name, c, inline ) -> snapshot ("quiz " ++ name) (View.view c inline))
            |> describe "quiz"
        , inlines
            |> List.map (\( name, inline ) -> snapshot ("reduce " ++ name) (wrap (View.reduce config [ chars "a. b", inline ])))
            |> describe "reduce"
        , snapshot "reduce all" (wrap (View.reduce config (List.map Tuple.second inlines)))
        , snapshot "viewer" (wrap (View.viewer config (List.map Tuple.second inlines)))
        , inlines
            |> List.map (\( name, inline ) -> snapshot ("media " ++ name) (View.viewMedia presentation inline))
            |> describe "viewMedia"
        , snapshot "media image config" (View.viewMedia config (Ref (Image [ chars "alt" ] "img.png" (Just [ chars "t" ])) attr))
        , snapshot "media oembed"
            (View.viewMedia { config | oEmbed = Just { maxwidth = 300, maxheight = 0, scale = 0.5, thumbnail = True } }
                (Ref (Embed [ chars "e" ] "https://e.org/x" Nothing) attr)
            )
        , snapshot "media oembed height"
            (View.viewMedia { config | oEmbed = Just { maxwidth = 0, maxheight = 200, scale = 1, thumbnail = False } }
                (Ref (Embed [ chars "e" ] "https://e.org/x" Nothing) [])
            )
        , snapshot "image no zoom" (View.view { config | image_zoom = False } (Ref (Image [ chars "alt" ] "img.png" Nothing) []))
        , snapshot "quiz drops" (wrap (View.viewQuizDrops drops))
        , snapshot "quiz drops inactive" (wrap (View.viewQuizDrops { drops | input = (\i -> { i | active = False }) drops.input }))
        , snapshot "drop here" (View.dropHere [ Html.Attributes.class "x" ] |> Html.map never)
        , snapshot "audio" (View.audio [] { url = "a.mp3", controls = False, preload = "auto", errorHandling = False } |> Html.map never)
        , snapshot "audio error" (View.audio [] { url = "a.mp3", controls = True, preload = "none", errorHandling = True } |> Html.map never)
        , snapshot "view_inf" (View.view_inf Array.empty En True False Nothing Nothing Nothing (Ref (Image [ chars "alt" ] "img.png" Nothing) []))
        , snapshot "view_inf media" (View.view_inf Array.empty De False True Nothing (Just Dict.empty) (Just (Dict.fromList [ ( "img.png", ( 1, 2 ) ) ])) (Container [ Ref (Image [] "img.png" Nothing) [], Ref (Link [ chars "l" ] "https://l.org" Nothing) [] ] []))
        ]
